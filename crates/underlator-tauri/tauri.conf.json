{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Underlator",
  "version": "0.1.0-beta",
  "identifier": "app.underlator.desktop",
  "build": {
    "frontendDist": "../../react-app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../../react-app",
      "script": "npm run start"
    },
    "beforeBuildCommand": {
      "cwd": "../../react-app",
      "script": "npm run build"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Underlator",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
