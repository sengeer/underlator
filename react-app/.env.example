# HTTP-режим против underlator-server (атом 4.2 / Vite-dev).
# Канонический стенд — compose same-origin на :8080 (token запекается в Dockerfile).
# Этот файл — для локального Vite (:8000) с proxy на :8080.

VITE_BACKEND_MODE=http
# Пусто = same-origin / Vite proxy (`/api`, `/healthz` → 127.0.0.1:8080).
VITE_BACKEND_URL=
# Shared secret = UNDERLATOR_AUTH_TOKEN compose (dev-default).
VITE_BACKEND_TOKEN=dev-change-me
